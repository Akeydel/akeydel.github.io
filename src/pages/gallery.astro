---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/CustomPage.astro';
---
<!--
<Layout
	title="Gallery"
	description="Collection of Photos!"
	pubDate={new Date('April 06 2026')}
></Layout>
-->
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
  <Header />


<style>
    /* ── HEADER ── */
    #header .tl-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      filter: opacity(100%) brightness(0.8);
      transition: filter 0.6s ease;
    }

    #header:hover .tl-bg {
      filter: opacity(100%) brightness(1);
    }

    #header .tl-year {
      position: relative;
      z-index: 2;
      text-align: center;
      border-top: 1px solid rgba(255,255,255,0.7);
      border-bottom: 1px solid rgba(255,255,255,0.7);
      padding: 6px 24px;
    }

    #header .tl-year p {
      font-family: 'FF-Plastilin', serif;
      font-size: 2rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      line-height: 1.2;
    }

    /* ── ABOUT STRIP (under header) ── */
    .about-strip {
      background: #07192a;
      padding: 1.4rem 2rem;
      text-align: center;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .about-strip h1 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #4fa8e8;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 0.25rem;
    }

    .about-strip p {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.6);
    }

    /* ── TIMELINE SECTIONS ── */
    .timeline-section {
      margin: 0;
    }

    .timeline-row {
      display: flex;
      background-color: #031625;
    }

    .timeline-row:hover .tl-item {
      width: 25%;
    }

    /* ── TIMELINE ITEM ── */
    .tl-item {
      position: relative;
      width: 100%;
      height: 52vh;
      min-height: 120px;
      color: #fff;
      overflow: hidden;
      transition: width .4s ease, scale .5s ease;
      cursor: pointer;
    }

    .tl-item .tl-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      filter: opacity(100%);
      transition: filter 0.5s ease;
    }

    /* gradient overlay always present */
    .tl-item::before {
      content: "";
      position: absolute;
      inset: 0;
      
      z-index: 1;
      opacity: 0;
      transform: translateY(8%);
      transition: opacity 1 ease, transform 0.5s ease;
    }

    .tl-item:hover {
      width: 50% !important;
      scale: 1.2;
      z-index: 999;
    }

    .tl-item:hover::before {
      opacity: 1;
      transform: translateY(0);
    }

    .tl-item:hover .tl-bg {
      filter: opacity(1);
    }

    .tl-item:hover .tl-year {
      opacity: 0;
      transform: translateX(-50%) translateY(-60%);
    }

    .tl-item:hover .tl-content {
      opacity: 1;
      transform: translateY(0);
    }

    /* year badge */
    .tl-item .tl-year {
      position: absolute;
      top: 38%;
      left: 50%;
      transform: translateX(-50%) translateY(-50%);
      z-index: 2;
      border-top: 1px solid rgba(255,255,255,0.8);
      border-bottom: 1px solid rgba(255,255,255,0.8);
      padding: 4px 12px;
      text-align: center;
      white-space: nowrap;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .tl-item .tl-year p {
      font-size: 1.25rem;
      font-weight: 500;
      line-height: 1.2;
    }

    /* content panel */
    .tl-content {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 2;
      padding: 1rem 1.1rem 1.2rem;
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.4s ease 0.28s, transform 0.4s ease 0.28s;
    }

    .tl-content h1 {
      font-size: 0.95rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #4fa8e8;
      margin-bottom: 0.4rem;
    }

    .tl-content p {
      font-size: 0.78rem;
      line-height: 1.45;
      color: rgba(255,255,255,0.82);
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .tl-content a {
      color: #4fa8e8;
      text-decoration: none;
    }

    .tl-content a:hover {
      text-decoration: underline;
    }

    /* dividers between row groups */
    .row-divider {
      height: 6px;
      background: #040f1a;
    }
</style>


  <!-- About strip -->
  <div class="about-strip">
    <h1>Anthony Keydel</h1>
    <p>Hi! About me!</p>
  </div>

  <div class="row-divider"></div>

  <!-- ROW 1 — 4 items -->
  <section class="timeline-section">
    <div class="timeline-row">

      <div class="tl-item">
        <div class="tl-bg" style="background-image: url('https://adventure.com/wp-content/uploads/2018/06/Van-life-van-in-the-USA-Photo-credit-tyler-lillico-443139-unsplash-1920x1080.jpg');"></div>
        <div class="tl-year"><p>Anthony</p></div>
        <div class="tl-content">
          <h1>Title Words and Font</h1>
          <p>Suspendisse potenti. Sed sollicitudin eros lorem, eget accumsan risus dictum id. Maecenas dignissim ipsum vel mi rutrum egestas.</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-bg" style="background-image: url('https://as1.ftcdn.net/v2/jpg/00/71/62/94/1000_F_71629481_zWelwvBOH57X6mmwJsvkpaN2MIOSyi9o.jpg');"></div>
        <div class="tl-year"><p>Flying 🪂</p></div>
        <div class="tl-content">
          <h1>Phasellus Mauris Elit</h1>
          <p>Mauris cursus magna at libero lobortis tempor. Aliquam interdum vulputate neque sit amet varius. Maecenas ac pulvinar nisi.</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-bg" style="background-image: url('https://i.ibb.co/ksKg5DLr/Finguns.png');"></div>
        <div class="tl-year"><p>SomethingElse</p></div>
        <div class="tl-content">
          <h1>I Swear Im Not Boring</h1>
          <p>Idk, maybe Stories or Latest or Timeline <a href="#">Link?</a></p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-bg" style="background-image: url('https://i.ibb.co/ksKg5DLr/Finguns.png');"></div>
        <div class="tl-year"><p>TEMPLATE</p></div>
        <div class="tl-content">
          <h1>Title</h1>
          <p><a href="#">Link?</a></p>
        </div>
      </div>

    </div>
  </section>

<Footer />